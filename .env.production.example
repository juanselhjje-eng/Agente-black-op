# Copy to .env in a protected deployment folder; never commit real values.
# Use 64+ random hexadecimal characters (letters/numbers only) for Compose URL compatibility.
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
PG_POOL_MAX=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
OWNER_WHATSAPP_NUMBER=
OWNER_ALERTS_ENABLED=false
OWNER_REPORTS_ENABLED=false
OWNER_DAILY_REPORT_TIME=08:00
OWNER_WEEKLY_REPORT_TIME=08:15
BLACKOPS_PUBLIC_API_BASE_URL=
BLACKOPS_API_ENABLED=false
WEBSITE_MONITOR_URL=
WEBSITE_MONITOR_INTERVAL_MS=300000
