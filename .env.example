# Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# PostgreSQL (optional locally; when set, it replaces JSON storage)
DATABASE_URL=
# Clave larga y aleatoria para integrar datos comerciales desde un sistema confiable
ADMIN_API_KEY=
PG_POOL_MAX=10
PGSSL=false

# Google Gemini
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Owner escalation and alerts
OWNER_WHATSAPP_NUMBER=
OWNER_ALERTS_ENABLED=false

# Black Ops public API documented in the business PDF; validate before enabling
BLACKOPS_PUBLIC_API_BASE_URL=
BLACKOPS_API_ENABLED=false

# Optional website availability monitor
WEBSITE_MONITOR_URL=
WEBSITE_MONITOR_INTERVAL_MS=300000

# Zona horaria para RESUMEN HOY / RESUMEN SEMANA
REPORT_TIMEZONE=America/Bogota

# Reportes automáticos al dueño (opt-in)
OWNER_REPORTS_ENABLED=false
OWNER_DAILY_REPORT_TIME=08:00
OWNER_WEEKLY_REPORT_TIME=08:15
